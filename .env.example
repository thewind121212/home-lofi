# Copy to .env (plain KEY=value, no quotes, no spaces around =). .env is git- and docker-ignored.

# Required: shared secret the reverse proxy injects as `x-home-gate` on /api/private (openssl rand -hex 32)
GATE_SECRET=

# Optional: owner-only settings sync across devices (README "Settings sync"). Off unless all three are set
# AND the proxy has the /api/private/settings location.
# DATABASE_URL=postgres://home_lofi:<password>@<db-host>:5432/home_lofi
# OWNER_USER=        # your Authelia username
# SYNC_SECRET=       # openssl rand -hex 32; that proxy location injects it as x-home-sync

# Optional: the notification hub (README "Notifications"): LAN machines POST /api/notify with this as a Bearer token.
# Off unless set, together with DATABASE_URL and OWNER_USER above (the owner sees them; they're kept in Postgres).
# NOTIFY_TOKEN=      # openssl rand -hex 32

# Optional: Steam card's games owned + total hours (https://steamcommunity.com/dev/apikey). The status works without it.
# STEAM_API_KEY=

# Optional: Spotify "now playing" pill in the header (public: track, artists, cover). README "Spotify now playing".
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=   # node scripts/spotify-auth.mjs (one-time consent)

# Optional: the owner's Reading bar, the books in progress in Kavita (README "Reading"). Off unless URL + key are set.
# KAVITA_URL=http://10.10.0.217:5000            # where this server reaches Kavita
# KAVITA_API_KEY=                               # a Kavita user's auth key; never commit it
# KAVITA_PUBLIC_URL=https://kavita.example.com  # the Continue links (none without it)

# Optional: the gaming PC on the Server card (README "Gaming PC"): moni-relay's address, and its MONI_WAKE_TOKEN for
# the owner's Wake-on-LAN button. Off unless PC_URL is set; no button without the token.
# PC_URL=http://10.10.0.217:5007
# PC_WAKE_TOKEN=     # the relay's relay/.env MONI_WAKE_TOKEN; never commit it
# KAVITA_TZ=Asia/Ho_Chi_Minh                    # Kavita's time zone (its read dates have no offset)

# Optional: where scene videos come from (build-time; empty = this app's public/scenes)
# SCENES_URL=https://static.example.com/scenes

# Optional: your weather API (server-side only)
# WEATHER_API_URL=https://api.weather.example.com

# Optional live stats for internal services. A widget is on when its *_URL is set.
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS=

NPM_URL=
NPM_USER=
NPM_PASS=

PORTAINER_URL=
PORTAINER_ENV=
PORTAINER_KEY=

# Nextcloud > Settings > System (serverinfo) token
NEXTCLOUD_URL=
NEXTCLOUD_TOKEN=

WUD_URL=
WUD_USER=
WUD_PASS=

# n8n > Settings > n8n API
N8N_URL=
N8N_API_KEY=

# Coolify > Keys & Tokens > API tokens, "read" permission only. Not COOLIFY_URL: Coolify reserves it
COOLIFY_API_URL=
COOLIFY_API_TOKEN=

MYSPEED_URL=
MYSPEED_PASS=
