# Copy to .env (plain KEY=value, no quotes, no spaces around =). .env is git- and docker-ignored.

# Required: shared secret the reverse proxy injects as `x-home-gate` on /api/private (openssl rand -hex 32)
GATE_SECRET=

# Optional: owner-only settings sync across devices (README "Settings sync"). Off unless all three are set
# AND the proxy has the /api/private/settings location.
# DATABASE_URL=postgres://home_lofi:<password>@<db-host>:5432/home_lofi
# OWNER_USER=        # your Authelia username
# SYNC_SECRET=       # openssl rand -hex 32; that proxy location injects it as x-home-sync

# Optional: Spotify "now playing" pill in the header (public: track, artists, cover). README "Spotify now playing".
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=   # node scripts/spotify-auth.mjs (one-time consent)

# Optional: where scene videos come from (build-time; empty = this app's public/scenes)
# SCENES_URL=https://static.example.com/scenes

# Optional: your weather API (server-side only)
# WEATHER_API_URL=https://api.weather.example.com

# Optional live stats for internal services. A widget is on when its *_URL is set.
ADGUARD_URL=
ADGUARD_USER=
ADGUARD_PASS=

NPM_URL=
NPM_USER=
NPM_PASS=

PORTAINER_URL=
PORTAINER_ENV=
PORTAINER_KEY=

# Nextcloud > Settings > System (serverinfo) token
NEXTCLOUD_URL=
NEXTCLOUD_TOKEN=

WUD_URL=
WUD_USER=
WUD_PASS=

# n8n > Settings > n8n API
N8N_URL=
N8N_API_KEY=

# Coolify > Keys & Tokens > API tokens, "read" permission only. Not COOLIFY_URL: Coolify reserves it
COOLIFY_API_URL=
COOLIFY_API_TOKEN=

MYSPEED_URL=
MYSPEED_PASS=
